# Copy to .env and adjust. Every value has a working default, so .env is
# optional for local development.

# --- storage (pipeline stage 6) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=crackcatch
# Fall back to an in-process database when MongoDB is unreachable. Handy for a
# laptop demo; the API reports it under /api/health so it is never silent.
# Set false in any real deployment.
ALLOW_MEMORY_DB_FALLBACK=true
STORAGE_DIR=./storage

# --- detection (pipeline stage 3) ---
MODEL_WEIGHTS=./model/weights/crackcatch.pt
CONFIDENCE_THRESHOLD=0.25
# auto | cpu | cuda | mps
INFERENCE_DEVICE=auto
# Allow the classical-CV baseline when no trained checkpoint exists.
DETECTOR_FALLBACK=true

# --- camera calibration (pipeline stage 4) ---
CAMERA_HEIGHT_M=1.35
CAMERA_PITCH_DEG=8.0
CAMERA_HFOV_DEG=78.0

# --- demo geo defaults (pipeline stage 5) ---
DEMO_ORIGIN_LAT=19.0760
DEMO_ORIGIN_LON=72.8777
DEMO_SPEED_KMPH=30.0

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
MAX_UPLOAD_MB=200
ALERT_PRIORITY_THRESHOLD=75

# --- auth (demo-grade; see docs/SECURITY.md) ---
AUTH_ENABLED=false
# API_TOKENS={"authority-demo-token":"authority","citizen-demo-token":"citizen"}
